<Window x:Class="ScreenShotManager.MusicSync.Views.Pairing.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:ScreenShotManager.Shared.Components"
        Title="Pair Phone"
        Height="820" Width="440"
        MinHeight="820" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Icon="/Icon/camera_2925432.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:CustomTitleBar Grid.Row="0" Title="🎵 Pair Phone"/>

        <StackPanel Grid.Row="1" Margin="25,15,25,25">
            <TextBlock Text="Scan with the music player app"
                       Style="{StaticResource SectionHeaderStyle}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- QR codes need a light quiet zone to scan reliably, hence the white card. -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="12"
                    HorizontalAlignment="Center">
                <Image x:Name="QrImage"
                       Width="260" Height="260"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <TextBlock x:Name="ExpiryText"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Address" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="EndpointText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Library" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="LibraryText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15,10"
                    Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Paired phones" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="NoDevicesText"
                               Text="None yet"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                Tag="{Binding Id}"
                                                Click="OnRemoveDeviceClick"
                                                Padding="10,4"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <TextBlock Text="The code works once and expires after 5 minutes. Each phone gets its own key; remove a phone to stop it syncing."
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- For the Android emulator (shares the PC clipboard) or sending the code to the phone. -->
                <Button x:Name="CopyCodeButton"
                        Content="Copy code"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,10,0"/>
                <Button x:Name="RegenerateButton"
                        Content="New code"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

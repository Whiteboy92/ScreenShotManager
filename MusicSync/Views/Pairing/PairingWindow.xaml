<Window x:Class="ScreenShotManager.MusicSync.Views.Pairing.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:ScreenShotManager.Shared.Components"
        Title="Pair Phone"
        Height="660" Width="440"
        MinHeight="660" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Icon="/Icon/camera_2925432.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:CustomTitleBar Grid.Row="0" Title="🎵 Pair Phone"/>

        <StackPanel Grid.Row="1" Margin="25,15,25,25">
            <TextBlock Text="Scan with the music player app"
                       Style="{StaticResource SectionHeaderStyle}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- QR codes need a light quiet zone to scan reliably, hence the white card. -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="12"
                    HorizontalAlignment="Center">
                <Image x:Name="QrImage"
                       Width="280" Height="280"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="Address" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="EndpointText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Library" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="LibraryText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Anyone who scans this code can download your music folder. Make a new code to unpair all phones."
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- For the Android emulator (shares the PC clipboard) or sending the code to the phone. -->
                <Button x:Name="CopyCodeButton"
                        Content="Copy code"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,10,0"/>
                <Button x:Name="RegenerateButton"
                        Content="New pairing code"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
